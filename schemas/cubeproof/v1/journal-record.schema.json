        },
        "reason": {
          "type": "string"
        },
        "policy_sha256": {
          "$ref": "common.schema.json#/$defs/Hash"
        }
      },
      "required": [
        "format",
        "seq",
        "prev",
        "self",
        "type",
        "utc",
        "node",
        "state",
        "reason",
        "policy_sha256"
      ],
      "additionalProperties": false
    },
    "node_reopen": {
