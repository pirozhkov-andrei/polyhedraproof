        },
        "prev": {
          "$ref": "common.schema.json#/$defs/Hash"
        },
        "self": {
          "$ref": "common.schema.json#/$defs/Hash"
        },
        "type": {
          "const": "handoff"
        },
        "utc": {
          "$ref": "common.schema.json#/$defs/UTC"
        },
        "request": {
          "$ref": "handoff-request.schema.json"
        },
        "shard": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "shard.schema.json"
            }
          ]
        },
        "shard_sha256": {
          "anyOf": [
