        },
        "utc": {
          "$ref": "common.schema.json#/$defs/UTC"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/AuditTarget"
        },
        "ordinal": {
          "$ref": "common.schema.json#/$defs/NonNegative"
        }
      },
      "required": [
        "format",
        "seq",
        "prev",
        "self",
        "type",
        "utc",
        "target",
